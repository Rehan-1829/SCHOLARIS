# Copy to .env and change the secret before showing this to anyone.
SECRET_KEY=replace-me-with-a-long-random-string
FLASK_APP=run.py
FLASK_DEBUG=1

# Leave DATABASE_URL empty to use the bundled SQLite file (recommended for the demo).
# To use a hosted Postgres instead, set something like:
# DATABASE_URL=postgresql://user:password@host:5432/scholaris
DATABASE_URL=

# Label shown across the app for the running academic session.
CURRENT_TERM=2026-27 · Odd semester
